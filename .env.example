# Copy to .env (for the terminal). NEVER commit .env
# Model (Lab 5): google = Gemini with ChatGoogleGenerativeAI (Labs 13-14)
#                openai = any OpenAI-compatible URL (OpenRouter, Google AI /openai/)
#                ollama = local model, no key
PROVIDER=google
MODEL=gemini-3.5-flash-lite
API_KEY=paste-your-model-key
# BASE_URL=https://openrouter.ai/api/v1   # only for PROVIDER=openai

# Web search (Lab 13), free key from https://app.tavily.com
TAVILY_API_KEY=paste-your-tavily-key

# n8n food-nutrition workflow PRODUCTION URL (Lab 16)
N8N_URL=https://YOUR-NAME.app.n8n.cloud/webhook/food-nutrition
